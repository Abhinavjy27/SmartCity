# ==============================================================================
# SUPADSP — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to version control.
# ==============================================================================

# ---- General ----
APP_NAME=SUPADSP
APP_ENV=development
APP_DEBUG=true
APP_PORT=8100
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-to-a-random-256-bit-key

# ---- PostgreSQL (Core + PostGIS + TimescaleDB) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supadsp
POSTGRES_USER=supadsp_user
POSTGRES_PASSWORD=change-me
POSTGRES_SSL_MODE=prefer
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ---- Elasticsearch ----
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=change-me
ELASTICSEARCH_URL=http://${ELASTICSEARCH_HOST}:${ELASTICSEARCH_PORT}

# ---- MinIO (S3-compatible Object Storage) ----
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=http://${MINIO_HOST}:${MINIO_PORT}

# ---- Apache Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# ---- Keycloak ----
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=supadsp-realm
KEYCLOAK_CLIENT_ID=supadsp-web
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_URL=http://${KEYCLOAK_HOST}:${KEYCLOAK_PORT}

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=s3://model-artifacts
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/mlflow

# ---- Feast (Feature Store) ----
FEAST_REPO_PATH=./ml/feature_store
FEAST_ONLINE_STORE_TYPE=redis
FEAST_OFFLINE_STORE_TYPE=file

# ---- GeoServer ----
GEOSERVER_HOST=localhost
GEOSERVER_PORT=8082
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change-me

# ---- Martin (Vector Tiles) ----
MARTIN_HOST=localhost
MARTIN_PORT=3001
MARTIN_DATABASE_URL=${DATABASE_URL}

# ---- Kong API Gateway ----
KONG_HOST=localhost
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# ---- Airflow ----
AIRFLOW_HOST=localhost
AIRFLOW_PORT=8401
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=${DATABASE_URL}

# ---- Monitoring ----
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090
GRAFANA_HOST=localhost
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
LOKI_HOST=localhost
LOKI_PORT=3100
JAEGER_HOST=localhost
JAEGER_PORT=16686

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gov.in
SMTP_PORT=587
SMTP_USER=noreply@supadsp.gov.in
SMTP_PASSWORD=change-me
SMTP_USE_TLS=true

# ---- SMS Gateway ----
SMS_GATEWAY_URL=https://sms-gateway.gov.in/api
SMS_GATEWAY_API_KEY=change-me
